Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

%labels
    Maintainer Guillaume Bouvier
    Version 2.0
    Description Apptainer container for Biohub's ESMFold2 (ESMC-based structure prediction)

%environment
    export PATH="/opt/conda/bin:$PATH"
    export TORCH_HOME="/opt/torch"
    export HF_HOME="/opt/torch/hf"
    export LC_ALL=C

%post
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        git \
        wget \
        curl \
        build-essential \
        libhdf5-dev \
        pkg-config \
        && rm -rf /var/lib/apt/lists/*

    # Install Micromamba
    curl -L https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C /usr/local/bin --strip-components=1 bin/micromamba

    # Create a conda/mamba environment with Python 3.12 and PyTorch with CUDA 12.4 support
    micromamba create -y -p /opt/conda -c pytorch -c nvidia -c conda-forge \
        python=3.12 \
        pytorch \
        pytorch-cuda=12.4 \
        numpy \
        pandas \
        scikit-learn \
        biopython \
        biotite \
        rdkit \
        cmake \
        git \
        && micromamba clean --all -y

    # Make conda/mamba active in the build process
    export PATH="/opt/conda/bin:$PATH"

    # Install the Biohub ESM repository containing ESMFold2
    pip install --no-cache-dir esm@git+https://github.com/Biohub/esm.git@main

    # Set directory for caching HF and Torch models
    mkdir -p /opt/torch/hf
    export TORCH_HOME="/opt/torch"
    export HF_HOME="/opt/torch/hf"

    # Pre-download ESMFold2 weights to make container run-capable offline
    python -c '
from transformers import AutoModel, AutoTokenizer
model_name = "biohub/ESMFold2"
print(f"Pre-downloading tokenizer for {model_name}...")
AutoTokenizer.from_pretrained(model_name)
print(f"Pre-downloading model weights for {model_name} (this will take a while)...")
AutoModel.from_pretrained(model_name)
'

    # Make cached models readable by all users
    chmod -R ugo+rX /opt/torch

%runscript
    # Run python scripts or inference pipelines using ESMFold2
    python "$@"
