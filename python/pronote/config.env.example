# Configuration pour la synchronisation Pronote -> Google Calendar / iCal
# ATTENTION : ne committez jamais ce fichier dans git s'il contient des mots de passe en clair.

# Identifiants ENT
ENT_USERNAME="prenom.nom"
ENT_PASSWORD=""

# URL Pronote
PRONOTE_URL="https://0750611g.index-education.net/pronote/parent.html"

# Nom de l'enfant (laisser vide si un seul enfant, ou préciser le nom tel qu'affiché sur Pronote)
CHILD_NAME=""

# Plage de synchronisation (en jours)
DAYS_PAST=7
DAYS_FUTURE=28

# Chemin de sortie du fichier ICS
OUTPUT_ICS_FILE="malo_pronote.ics"
